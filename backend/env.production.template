# 生产环境配置模板
# 复制此文件为 .env.production 并填入实际值
# 注意：生产环境的敏感信息必须使用环境变量或密钥管理系统

# Spring Profiles 配置
SPRING_PROFILES_ACTIVE=prod
SPRING_PROFILES_INCLUDE=encryption-prod,chigua-prod

# 服务器配置
SERVER_PORT=8080
CONTEXT_PATH=/

# 数据库配置（必须配置）
DB_USERNAME=root
DB_PASSWORD=your-production-db-password
DB_URL=jdbc:mysql://your-production-db-host:port/chigua?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=true&serverTimezone=GMT%2B8

# 从库配置（可选）
DB_SLAVE_URL=
DB_SLAVE_USERNAME=
DB_SLAVE_PASSWORD=

# Redis配置（必须配置）
REDIS_HOST=10.0.0.11
REDIS_PORT=26379
REDIS_DATABASE=0
REDIS_PASSWORD=chigua_redis

# JWT配置（必须配置强密钥）
JWT_SECRET=your-very-strong-production-jwt-secret-key
JWT_EXPIRE_TIME=30

# Swagger配置（生产环境建议关闭）
SWAGGER_ENABLED=false

# 应用配置
APP_NAME=ChiguaVideo
UPLOAD_PATH=/data/uploads
LOG_PATH=/data/logs

# R2存储配置（必须配置）
R2_ENDPOINT=https://74dcb623526e1925a35e0991a0940f16.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-production-r2-access-key-id
R2_SECRET_KEY=your-production-r2-secret-key
R2_BUCKET_NAME=51chigua

# 图片加密配置（生产环境强制启用）
IMAGE_ENCRYPTION_ENABLED=true
IMAGE_ENCRYPTION_KEY=your-production-image-encryption-key

# URL签名配置（生产环境强制启用）
URL_SIGNATURE_SECRET=your-production-url-signature-secret
URL_SIGNATURE_ENABLED=true

# 数据加密配置（生产环境强制启用）
DATA_ENCRYPTION_ENABLED=true
DATA_ENCRYPTION_SECRET_KEY=your-production-data-encryption-secret

# 域名配置
CHIGUA_MAIN_DOMAIN=https://chigua-r2-worker.xingaikaka.workers.dev
CHIGUA_FALLBACK_DOMAIN=https://74dcb623526e1925a35e0991a0940f16.r2.cloudflarestorage.com

# Druid监控配置
DRUID_USERNAME=your-druid-username
DRUID_PASSWORD=your-druid-password

# URL过期时间配置
URL_EXPIRES_DEFAULT=3600
URL_EXPIRES_SHORT=1800
URL_EXPIRES_LONG=7200

# 下载限制配置
DOWNLOAD_LIMIT_VIDEO=3
DOWNLOAD_LIMIT_STREAM=10
DOWNLOAD_LIMIT_DEFAULT=5

# 加密性能配置
ENCRYPTION_CACHE_ENABLED=true
ENCRYPTION_CACHE_TTL=300
ENCRYPTION_MAX_CACHE_SIZE=1000
ENCRYPTION_TIMESTAMP_TOLERANCE=300000
ENCRYPTION_MAX_RETRIES=3

# 调试配置（生产环境关闭）
ENCRYPTION_DEBUG_ENABLED=false
ENCRYPTION_PERFORMANCE_LOG=false
ENCRYPTION_LOG_LEVEL=WARN
ENCRYPTION_UTIL_LOG_LEVEL=WARN
