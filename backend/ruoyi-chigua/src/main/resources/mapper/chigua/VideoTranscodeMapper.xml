    </delete>

    <select id="selectUnusedTranscodes" parameterType="VideoTranscode" resultMap="VideoTranscodeResult">
        SELECT vt.*, 0 as is_used
        FROM video_transcodes vt 
        <where>
            NOT EXISTS (
                SELECT 1 FROM videos v 
                WHERE v.transcode_id = vt.id 
                  AND v.transcode_id IS NOT NULL
            )
            <if test="uid != null and uid != ''"> and vt.uid = #{uid}</if>
            <if test="videoType != null and videoType != ''"> and vt.video_type = #{videoType}</if>
            <if test="status != null and status != ''"> and vt.status = #{status}</if>
            <if test="transcodeResult != null and transcodeResult != ''"> and vt.transcode_result = #{transcodeResult}</if>
            <if test="orgfile != null and orgfile != ''"> and vt.orgfile LIKE CONCAT('%', #{orgfile}, '%')</if>
            <if test="resolution != null and resolution != ''"> and vt.resolution LIKE CONCAT('%', #{resolution}, '%')</if>
        </where>
        order by vt.created_at desc
    </select>

    <select id="selectAllTranscodesWithUsageStatus" parameterType="VideoTranscode" resultMap="VideoTranscodeResult">
        SELECT vt.*, 
               CASE WHEN EXISTS (
                   SELECT 1 FROM videos v 
                   WHERE v.transcode_id = vt.id 
                     AND v.transcode_id IS NOT NULL
               ) THEN 1 ELSE 0 END as is_used
        FROM video_transcodes vt 
        <where>
            <if test="uid != null and uid != ''"> and vt.uid = #{uid}</if>
            <if test="videoType != null and videoType != ''"> and vt.video_type = #{videoType}</if>
            <if test="status != null and status != ''"> and vt.status = #{status}</if>
            <if test="transcodeResult != null and transcodeResult != ''"> and vt.transcode_result = #{transcodeResult}</if>
            <if test="orgfile != null and orgfile != ''"> and vt.orgfile LIKE CONCAT('%', #{orgfile}, '%')</if>
            <if test="resolution != null and resolution != ''"> and vt.resolution LIKE CONCAT('%', #{resolution}, '%')</if>
        </where>
        order by vt.created_at desc
    </select>

    <update id="markTranscodeAsUsed">
        <!-- 注释：此方法现在仅作日志记录用途，实际使用状态通过videos表关联查询 -->
        <!-- 更新时间作为使用标记 -->
        update video_transcodes 
        set updated_at = NOW()
        where transcode_id = #{transcodeId}
    </update>

    <!-- 测试查询：检查关联关系 -->
    <select id="testAssociationQuery" resultType="java.util.Map">
        SELECT 
            'database_info' as table_name,
            DATABASE() as database_name,
            @@hostname as host_name,
            USER() as user_name
        
        UNION ALL
        
        SELECT 
            'video_transcodes' as table_name,
            COUNT(*) as total_count,
            COUNT(CASE WHEN transcode_result = 'ok' THEN 1 END) as ok_count,
            ''
        FROM video_transcodes
        
        UNION ALL
        
        SELECT 
            'videos' as table_name,
            COUNT(*) as total_count,
            COUNT(CASE WHEN transcode_id IS NOT NULL AND transcode_id != '' THEN 1 END) as with_transcode_id,
            ''
        FROM videos
        
        UNION ALL
        
        SELECT 
            'sample_videos_transcode_ids' as table_name,
            '' as col1,
            '' as col2,
            GROUP_CONCAT(DISTINCT transcode_id LIMIT 3) as sample_ids
        FROM videos 
        WHERE transcode_id IS NOT NULL AND transcode_id != ''
        LIMIT 1
    </select>

