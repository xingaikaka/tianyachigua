# Vue后台管理系统 - 生产环境配置模板

# 应用标题
VUE_APP_TITLE=吃瓜管理系统

# 生产环境后端API地址
VUE_APP_BASE_API=/prod-api

# 路由模式 hash 或 history
VUE_APP_ROUTER_MODE=hash

# 生产环境配置
NODE_ENV=production

# 是否启用调试模式（生产环境关闭）
VUE_APP_DEBUG=false

# 生产服务器端口
VUE_CLI_SERVICE_PORT=81

# 生产服务器主机
VUE_CLI_SERVICE_HOST=0.0.0.0

# 后台统计接口令牌（可选）
VUE_APP_STATS_ADMIN_TOKEN=
