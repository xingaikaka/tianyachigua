# 开发环境配置
NODE_ENV = development

# 接口地址 - 开发环境
VUE_APP_BASE_API = '/dev-api'

# 应用标题
VUE_APP_TITLE = 吃瓜视频管理系统

# 开发环境启用源码映射
VUE_APP_SOURCEMAP = true

# 开发环境不启用gzip压缩
VUE_APP_GZIP = false

# 开发环境保留console
VUE_APP_DROP_CONSOLE = false

# 图片解密密钥（必须与后端 chigua.r2.image-encryption.key 保持一致）
VUE_APP_IMAGE_ENCRYPTION_KEY = DR4jiK+U+Z6QwyuVxp//Cl3Zl543bl1xiQrfH6hnLc4=
